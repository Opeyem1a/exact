{
    "manifest_version": 2,
    "name": "Exact — Browse with intention",
    "description": "Instagram, X, LinkedIn and YouTube arrive in grey. Rest your cursor on a photo or video and it develops into full colour.",
    "version": "0.0.0",
    "icons": {
        "16": "assets/icon-16.png",
        "32": "assets/icon-32.png",
        "48": "assets/icon-48.png",
        "64": "assets/icon-64.png",
        "128": "assets/icon-128.png"
    },
    "browser_action": {
        "default_popup": "src/popup/popup.html",
        "browser_style": false
    },
    "content_scripts": [
        {
            "matches": [
                "*://*.instagram.com/*",
                "*://*.linkedin.com/*",
                "*://*.youtube.com/*",
                "*://*.x.com/*"
            ],
            "js": ["content/main.js"],
            "css": ["content/main.css"],
            "run_at": "document_start"
        }
    ],
    "browser_specific_settings": {
        "gecko": {
            "id": "opey-extension@domain.com",
            "strict_min_version": "102.0"
        }
    }
}
